{
  "name": "banknote-analytics-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Banknote AI Analytics Dashboard — BigQuery + Vite + React",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-env.js",
    "dev": "npm run setup && concurrently -n server,client -c blue,green \"npm run server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "server": "node server/index.js",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run dev:client\"",
    "start:prod": "npm run build && node server/index.js",
    "refresh-summaries": "node scripts/refresh-summaries.js",
    "refresh-summaries:product": "node scripts/refresh-product-summaries.js",
    "discover-events": "node scripts/discover-events.js",
    "validate:summary": "node scripts/validate-summary-vs-raw.js",
    "seed-admin": "node scripts/seed-admin.js"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.0",
    "@tanstack/react-query": "^5.101.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.469.0",
    "mongodb": "^6.21.0",
    "nodemailer": "^9.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
