# Registered apps (comma-separated). Add a new id here to onboard another product.
PRODUCTS=banknote,coinzy

# —— Banknote (legacy keys still work) ——
GCP_PROJECT=banknote-app-4f3fd
BQ_DATASET=analytics_488476338
BQ_SUMMARY_DATASET=analytics_summary
GOOGLE_APPLICATION_CREDENTIALS=../secrets/bigquery-metabase-sa.json
USE_SUMMARY_TABLES=true
# Or explicit:
# PRODUCT_BANKNOTE_LABEL=Banknote
# PRODUCT_BANKNOTE_GCP_PROJECT=banknote-app-4f3fd
# PRODUCT_BANKNOTE_BQ_DATASET=analytics_488476338
# PRODUCT_BANKNOTE_GOOGLE_APPLICATION_CREDENTIALS=../secrets/bigquery-metabase-sa.json
# PRODUCT_BANKNOTE_PREFER_RAW=false
# PRODUCT_BANKNOTE_COLOR=#4f8cff

# —— Coinzy (legacy keys still work) ——
COINZY_GCP_PROJECT=coinzy-26a4d
COINZY_BQ_DATASET=analytics_487601380
COINZY_BQ_SUMMARY_DATASET=analytics_summary
COINZY_GOOGLE_APPLICATION_CREDENTIALS=../secrets/coinzy-analytics-dashboard-sa.json
COINZY_USE_SUMMARY_TABLES=true
COINZY_PREFER_RAW=false

# —— Example: add a third app ——
# PRODUCTS=banknote,coinzy,stampzy
# PRODUCT_STAMPZY_LABEL=Stampzy
# PRODUCT_STAMPZY_GCP_PROJECT=stampzy-xxxxx
# PRODUCT_STAMPZY_BQ_DATASET=analytics_123456789
# PRODUCT_STAMPZY_GOOGLE_APPLICATION_CREDENTIALS=../secrets/stampzy-sa.json
# PRODUCT_STAMPZY_PREFER_RAW=true
# PRODUCT_STAMPZY_COLOR=#a78bfa

# Server
PORT=3001
HOST=0.0.0.0
VITE_API_URL=http://localhost:3001

# Production / Docker / Render: paste SA JSON (or base64) instead of files
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
# COINZY_GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Dashboard login — MongoDB is the user store. These seed the first admin if missing.
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
DASHBOARD_EMAIL=you@company.com
AUTH_SECRET=replace-with-a-long-random-string

# MongoDB Atlas (users & access)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB=analytics_dashboard

# Monthly reports (one email per app). Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 and an App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Product Analytics <you@gmail.com>
# REPORT_EMAIL=founder@company.com
# DASHBOARD_PUBLIC_URL=https://your-service.onrender.com

# Defaults
DEFAULT_DAYS=30
